{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @workspace/db run push && NODE_ENV=development tsx watch src/index.ts",
    "build": "node ./build.mjs",
    "prestart": "pnpm --filter @workspace/db run push",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "tsx --test src/**/*.test.ts",
    "test:folder-import-integration": "tsx test/integration/folderImportRecovery.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "@clerk/backend": "^3.17.1",
    "@clerk/express": "^2.1.66",
    "@clerk/shared": "^4.31.0",
    "@google-cloud/storage": "^8.0.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "http-proxy-middleware": "^4.2.0",
    "openai": "^6.49.0",
    "mammoth": "^1.10.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.3",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
